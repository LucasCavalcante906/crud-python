# Copie para .env e ajuste se quiser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crud_db

# Porta do Postgres exposta na sua máquina (mude se a 5432 já estiver em uso)
POSTGRES_PORT_EXTERNO=5432

# Porta da API na sua máquina
API_PORT=8000

# Porta do front (nginx) na sua máquina
WEB_PORT=8080
